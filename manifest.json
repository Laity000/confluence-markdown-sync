{
  "manifest_version": 3,
  "name": "Markdown → Confluence 内网同步",
  "version": "1.2.0",
  "description": "在已登录的 Confluence 页面会话中预览并一键同步 Markdown，检查版本冲突；备份可手动下载。",
  "action": {
    "default_title": "打开 Markdown → Confluence 同步工具"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "tabs",
    "downloads",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
